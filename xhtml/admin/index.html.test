        <!-- Dynamic Dashboard JS -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            fetch('../backend/dashboard_api.php')
                .then(response => response.json())
                .then(res => {
                    if (res.success) {
                        const data = res.data;
                        
                        // Update Stats
                        document.getElementById('stat-members').textContent = data.total_members;
                        document.getElementById('stat-registrations').textContent = data.new_registrations;
                        document.getElementById('stat-classes').textContent = data.active_classes;
                        document.getElementById('stat-revenue').textContent = data.revenue + '$';
                        
                        // Update Top Instructors
                        const tbodyInstructors = document.getElementById('table-instructors');
                        if(tbodyInstructors) {
                            tbodyInstructors.innerHTML = '';
                            if (data.top_instructors.length > 0) {
                                data.top_instructors.forEach((inst, index) => {
                                    tbodyInstructors.innerHTML += `
                                        <tr>
                                            <td>${index + 1}</td>
                                            <td>${inst.name}</td>
                                            <td><span class="badge badge-rounded badge-primary">${inst.classes_count} Classes</span></td>
                                            <td>
                                                <a href="javascript:void(0);" class="btn btn-sm btn-primary"><i class="la la-pencil"></i></a>
                                                <a href="javascript:void(0);" class="btn btn-sm btn-danger"><i class="la la-trash-o"></i></a>
                                            </td>
                                        </tr>
                                    `;
                                });
                            } else {
                                tbodyInstructors.innerHTML = '<tr><td colspan="4" class="text-center">No instructors found</td></tr>';
                            }
                        }
                        
                        // Update Recent Registrations
                        const tbodyRegistrations = document.getElementById('table-registrations');
                        if(tbodyRegistrations) {
                            tbodyRegistrations.innerHTML = '';
                            if (data.recent_registrations.length > 0) {
                                data.recent_registrations.forEach((reg, index) => {
                                    let badgeClass = 'badge-primary';
                                    if (reg.status === 'Pending') badgeClass = 'badge-warning';
                                    else if (reg.status === 'Canceled') badgeClass = 'badge-danger';
                                    else if (reg.status === 'Confirmed') badgeClass = 'badge-success';
                                    
                                    tbodyRegistrations.innerHTML += `
                                        <tr>
                                            <td>${index + 1}</td>
                                            <td>${reg.name}</td>
                                            <td>${reg.instructor || 'N/A'}</td>
                                            <td>${reg.booking_date}</td>
                                            <td><span class="badge badge-rounded ${badgeClass}">${reg.status || 'Confirmed'}</span></td>
                                            <td>${reg.class_name}</td>
                                            <td>${reg.price || '0'}$</td>
                                            <td>
                                                <a href="javascript:void(0);" class="btn btn-sm btn-primary"><i class="la la-pencil"></i></a>
                                                <a href="javascript:void(0);" class="btn btn-sm btn-danger"><i class="la la-trash-o"></i></a>
                                            </td>
                                        </tr>
                                    `;
                                });
                            } else {
                                tbodyRegistrations.innerHTML = '<tr><td colspan="8" class="text-center">No recent registrations found</td></tr>';
                            }
                        }
                    } else {
                        console.error('Error fetching dashboard data:', res.error);
                    }
                })
                .catch(err => console.error('Dashboard fetch error:', err));
        });
    </script>
</body>
</html>












